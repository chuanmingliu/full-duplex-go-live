# Stage latencies for the mock providers, so the engine's own latency work can
# be measured A/B on one machine: no credentials, no network weather.
#
#   make run-sim        # start golive with these delays
#   make bench-sim      # in another shell: measure it
#
# The numbers are modelled on the stage timings in BENCHMARK.md for the
# Tencent + DeepSeek + MiniMax stack. They are a stand-in for those vendors, not
# a measurement of them: use this to compare two builds of golive, and a real
# profile to find out what a call actually costs.

# What every caller says. The mock recognizer hears it at 180 ms a character.

# Recognizer: a handshake, hypotheses that run behind the speaker, and a final
# transcript that takes a moment after the audio stops. VOICED_ONLY makes the
# hypothesis stop growing when the speaker does, as a real one's would.
GOLIVE_MOCK_ASR_DIAL_MS=150
GOLIVE_MOCK_ASR_LAG_MS=200
GOLIVE_MOCK_ASR_FINAL_MS=100
GOLIVE_MOCK_ASR_VOICED_ONLY=true

# Backend: time to first token, then a steady stream.
GOLIVE_MOCK_LLM_TTFT_MS=700
GOLIVE_MOCK_LLM_RUNE_MS=25

# Synthesizer: a handshake, time to first byte, and one sentence at a time.
GOLIVE_MOCK_TTS_DIAL_MS=200
GOLIVE_MOCK_TTS_TTFB_MS=250
GOLIVE_MOCK_TTS_SERIAL=true

# The caller's vocabulary for cmd/golivefdb: a tone's pitch picks the phrase (bin/golivefdb -print-env).
GOLIVE_MOCK_PHRASES=帮我查一下车险一年大概多少钱|我想问一下|车险一年多少钱|嗯|对对|呃|等一下我接个电话|那交强险呢|你好|我的车是去年买的大概二十万|可以|好的那商业险呢|先别说|我想换个方案把车损险去掉|好
