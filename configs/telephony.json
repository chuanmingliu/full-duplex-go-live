{
  "addr": "127.0.0.1:8765",
  "log_level": "debug",
  "log_format": "text",
  "web_root": "",
  "auth_required": false,
  "allow_provider_override": false,
  "enable_metrics": true,
  "max_sessions": 0,
  "max_sessions_per_ip": 0,
  "shutdown_timeout_seconds": 10,
  "asr": "tencent",
  "llm": "deepseek",
  "tts": "minimax",
  "model": "golive-1",
  "greeting": "",
  "language": "zh",
  "speed": 1.2,
  "client_rate": 16000,
  "instructions": "你是一个电话语音助手。用简短口语化的中文回答，每次一到两句话，不要使用列表、标题或书面语。需要查询的问题先说明正在查，不要凭空猜测结果。",
  "backend_model": "deepseek-chat",
  "backend_base_url": "https://api.deepseek.com",
  "temperature": 0.7,
  "max_output_tokens": 512,
  "disable_thinking": true,
  "llm_hedge": 8,
  "llm_hedge_after_ms": 0,
  "tts_hedge": 2,
  "tts_hedge_after_ms": 260,
  "tts_hedge_rpm": 4,
  "tts_account_rpm": 10,
  "tts_pool_after_ms": 0,
  "tts_fallback": "fish",
  "tts_fallback_after_ms": 320,
  "tools_base_url": "http://127.0.0.1:8791",
  "tools_memory": true,
  "tools_workers": 4,
  "tools_deliver_wait_ms": 1500,
  "tools_end_call": true,
  "tools": [
    {
      "name": "quote_total",
      "description": "计算当前投保方案的总保费（含各险种明细）。当用户要求报价、问“一共多少钱”、或方案改动后要求重新算时调用。计算在后台进行，需要几秒；调用后立即告诉用户稍等，并继续回答用户的其他问题，结果出来后系统会通知你再向用户报告。方案以工作记忆中的 quote 字段为准，调用前请确保已用 update_memory 记录了用户确认的险种组合。",
      "parameters": {"type": "object", "properties": {"config": {"type": "object", "description": "可选：临时覆盖工作记忆中的险种选择，键为险种名，值为 true/false 或档位（如“300万”）"}}},
      "url": "/api/tools/quote",
      "async": true,
      "timeout_ms": 120000,
      "eta_s": 20
    }
  ],
  "history_turns": 16,
  "duplex": {
    "backchannel": false,
    "backchannel_after_ms": 2600,
    "backchannel_every_ms": 4200,
    "backchannel_phrases": [
      "嗯",
      "好的",
      "我在听"
    ],
    "user_backchannel_phrases": ["哦", "不错", "没问题", "确实", "你接着说", "接着说", "嗯呵", "嗯", "对", "是", "是的", "好", "行", "噢", "啊", "呀", "哎", "诶", "真的吗", "然后呢", "这样啊", "原来如此", "没错", "就是", "对对对", "好好好", "嗯嗯", "哈哈", "呵呵", "对对", "是是", "嗯嗯嗯", "好嘞"],
    "user_backchannel_hold_ms": 600,
    "holding_filler": false,
    "holding_filler_after_ms": 1500,
    "holding_filler_phrases": [
      "我看一下",
      "稍等一下",
      "让我查一下"
    ],
    "speculative": true,
    "speculative_stable_ms": 180,
    "speculative_min_chars": 4,
    "allow_barge_in": true,
    "on_new_query": "cut",
    "reset_tts_on_interrupt": false,
    "playback_chunk_ms": 40,
    "playback_paced": true,
    "playback_lead_ms": 300,
    "stream_first_chunk_chars": 4,
    "stream_first_chunk_deadline_ms": 160,
    "stream_first_chunk_grace_ms": 30,
    "stream_min_chunk_chars": 24,
    "stream_max_chunk_chars": 120,
    "delegation_mode": "responses",
    "delegate_min_chars": 1,
    "session_max_seconds": 3600,
    "idle_timeout_seconds": 300,
    "max_append_chars": 1500,
    "speculative_eager_ms": 100,
    "speculative_settle_ms": 80,
    "semantic_endpointing": true,
    "patient_silence_ms": 700,
    "asr_predial": true,
    "tts_native_rate": true,
    "phrase_cache": true,
    "phrase_cache_learn_chars": 12,
    "client_delegation": "always",
    "settled_close_ms": 600,
    "backend_prefix_warm_start": true,
    "ignore_hesitations": true,
    "focus": "veto",
    "focus_url": "ws://127.0.0.1:8032/verify",
    "focus_token_file": "",
    "focus_veto_share": 0.95,
    "focus_profile": "",
    "focus_min_voiced_ms": 240,
    "speculate_while_patient": true,
    "early_final_ms": 120
  },
  "vad": {
    "frame_ms": 20,
    "min_speech_ms": 200,
    "min_silence_ms": 380,
    "speech_pad_ms": 240,
    "max_speech_ms": 30000,
    "snapshot_ms": 40,
    "noise_floor_db": -60,
    "max_noise_floor_db": -28,
    "speech_margin_db": 10,
    "max_zcr": 0.55,
    "gap_tolerance_ms": 160,
    "barge_in_margin_db": 16,
    "barge_in_min_speech_ms": 320,
    "echo_tail_ms": 600,
    "line_fill_ms": 100
  },
  "realtime": {
    "enabled": true,
    "sample_rate": 16000,
    "dialect": "beta",
    "hold_for_opening": true,
    "hold_timeout_seconds": 45,
    "honor_turn_detection": false,
    "min_silence_floor_ms": 200
  },
  "telemetry_url": "http://127.0.0.1:8768/ingest"
}
