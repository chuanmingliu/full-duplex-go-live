{
  "addr": "127.0.0.1:8765",
  "log_level": "debug",
  "log_format": "text",
  "web_root": "",
  "auth_required": false,
  "allow_provider_override": false,
  "enable_metrics": true,
  "max_sessions": 0,
  "max_sessions_per_ip": 0,
  "shutdown_timeout_seconds": 10,
  "asr": "tencent",
  "llm": "deepseek",
  "tts": "minimax",
  "model": "golive-1",
  "greeting": "",
  "language": "zh",
  "speed": 1.2,
  "client_rate": 16000,
  "instructions": "你是一个电话语音助手。用简短口语化的中文回答，每次一到两句话，不要使用列表、标题或书面语。需要查询的问题先说明正在查，不要凭空猜测结果。",
  "backend_model": "deepseek-chat",
  "backend_base_url": "https://api.deepseek.com",
  "temperature": 0.7,
  "max_output_tokens": 512,
  "disable_thinking": true,
  "history_turns": 16,
  "duplex": {
    "backchannel": false,
    "backchannel_after_ms": 2600,
    "backchannel_every_ms": 4200,
    "backchannel_phrases": [
      "嗯",
      "好的",
      "我在听"
    ],
    "user_backchannel_phrases": [],
    "user_backchannel_hold_ms": 600,
    "holding_filler": false,
    "holding_filler_after_ms": 1500,
    "holding_filler_phrases": [
      "我看一下",
      "稍等一下",
      "让我查一下"
    ],
    "speculative": true,
    "speculative_stable_ms": 180,
    "speculative_min_chars": 4,
    "allow_barge_in": true,
    "on_new_query": "cut",
    "reset_tts_on_interrupt": false,
    "playback_chunk_ms": 40,
    "playback_paced": true,
    "playback_lead_ms": 300,
    "stream_first_chunk_chars": 6,
    "stream_first_chunk_deadline_ms": 220,
    "stream_min_chunk_chars": 24,
    "stream_max_chunk_chars": 120,
    "delegation_mode": "responses",
    "delegate_min_chars": 1,
    "session_max_seconds": 3600,
    "idle_timeout_seconds": 300,
    "max_append_chars": 1500,
    "speculative_eager_ms": 100,
    "speculative_settle_ms": 80,
    "semantic_endpointing": true,
    "patient_silence_ms": 700,
    "asr_predial": true,
    "tts_native_rate": true,
    "phrase_cache": true,
    "client_delegation": "always"
  },
  "vad": {
    "frame_ms": 20,
    "min_speech_ms": 200,
    "min_silence_ms": 380,
    "speech_pad_ms": 240,
    "max_speech_ms": 30000,
    "snapshot_ms": 40,
    "noise_floor_db": -60,
    "max_noise_floor_db": -28,
    "speech_margin_db": 10,
    "max_zcr": 0.55,
    "gap_tolerance_ms": 160,
    "barge_in_margin_db": 6,
    "barge_in_min_speech_ms": 320
  },
  "realtime": {
    "enabled": true,
    "sample_rate": 16000,
    "dialect": "beta",
    "hold_for_opening": true,
    "hold_timeout_seconds": 45
  },
  "telemetry_url": "http://127.0.0.1:8768/ingest"
}
