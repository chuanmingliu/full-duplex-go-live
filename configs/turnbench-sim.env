# The mocks for a smoke test of cmd/goliveturn: every utterance is heard as
# the same words, revealed as the audio arrives, so the plumbing (two
# channels, the floor rule, the predictions file) can be checked without a
# recognizer or the dataset.
GOLIVE_MOCK_TRANSCRIPT=so what I was thinking is that we should do it next week
GOLIVE_MOCK_ASR_DIAL_MS=80
GOLIVE_MOCK_ASR_LAG_MS=250
GOLIVE_MOCK_ASR_FINAL_MS=90
GOLIVE_MOCK_ASR_VOICED_ONLY=true
GOLIVE_MOCK_ASR_MS_PER_RUNE=60
