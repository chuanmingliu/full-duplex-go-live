# Copy into an ignored .env.local or supply through the process environment.
# No key is needed to build or run local mock-router tests.
SPEKO_API_KEY=
SPEKO_LIVE_URL=wss://router.speko.dev/v1/live
# SIP protocol bridge; native /v1/live clients choose their own delegation.
# The tested Router route requires client mode; managed responses was unavailable.
SPEKO_DELEGATION_MODE=client
SPEKO_RESPONSES_MODEL=gpt-6-luna
# Separate credential used by your clients to reach this service.
GOLIVE_AUTH_TOKEN=
# Same value as GOLIVE_AUTH_TOKEN when the SIP adapter uses this service.
GOLIVE_ADAPTER_TOKEN=
# For cmd/golive only; cmd/golive-speko always exposes its relay.
GOLIVE_SPEKO_ENABLED=true
