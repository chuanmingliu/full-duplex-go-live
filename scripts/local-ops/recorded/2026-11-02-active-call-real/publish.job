#timeout 45
#push activecall-review-20261102.md /home/chuanming/golive/activecall-review-20261102.md
#pull /home/chuanming/golive-telephony/codex-latency/review-out-mvykfqfn-wibn/published.json review-out-mvykfqfn-wibn-published.json
set -eu
python3 -B - <<'PY'
from pathlib import Path
import hashlib,json,os,urllib.request
os.umask(0o077)
call='out-mvykfqfn-wibn';root=Path.home()/'golive-telephony'
raw=(Path.home()/'golive/activecall-review-20261102.md').read_bytes()
assert hashlib.sha256(raw).hexdigest()=='1a606efbc0ce0d062dd4cc8491a2c0eca1601b63e43fa8c69404fe159d232c36'
def get():
    with urllib.request.urlopen('http://192.168.71.9:8790/api/calls/'+call,timeout=12) as f:return json.load(f)
d=get()
assert d['call']['id']==call and d['call']['build']=='f1fd9a6' and d['call']['ended_at'] and d['archive']['archived']
p=root/'journal/retros'/f'{call}.md'
assert not p.exists(), 'Retrospective exists; do not overwrite'
with p.open('xb') as f:f.write(raw);f.flush();os.fsync(f.fileno())
assert get().get('retrospective'), 'Journal has not loaded the review'
receipt={'call':call,'stage':'verified','retrospective_sha256':hashlib.sha256(raw).hexdigest(),'runtime_changed':False}
(root/'codex-latency'/('review-'+call)/'published.json').write_text(json.dumps(receipt,indent=2)+'\n')
print(json.dumps(receipt))
PY
