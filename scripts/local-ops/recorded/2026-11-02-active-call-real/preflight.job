#timeout 45
set -eu
cd "$HOME/golive-telephony"
python3 -B - <<'PY'
from pathlib import Path
import datetime,hashlib,json,os,re,subprocess,urllib.request
os.umask(0o077)
root=Path.home()/'golive-telephony'
journal_deploy=json.loads((root/'codex-latency/deployment-journal-0c2ba18.json').read_text())
assert journal_deploy.get('stage')=='verified','Journal rollout is not verified'
deployment=json.loads((root/'codex-latency/deployment-interrupt-f1fd9a6.json').read_text())
assert deployment.get('stage')=='verified' and deployment.get('new_version')=='f1fd9a6' and deployment.get('phrase_warm_verified'),'Phone rollout is not verified'
def get(url):
 with urllib.request.urlopen(url,timeout=8) as r:return json.load(r)
def sha(raw):return hashlib.sha256(raw).hexdigest()
binding=get('http://127.0.0.1:3000/api/realtime/brain')
assert binding.get('backend')=='local' and binding.get('revision')==13 and binding.get('endpoint')=='ws://127.0.0.1:8765/v1/realtime','Active Call backend changed'
h=get('http://127.0.0.1:8765/healthz')
assert h.get('status')=='ok' and h.get('sessions')==0 and h.get('version')=='f1fd9a6','Service is busy, unhealthy or a different build'
assert get('http://127.0.0.1:8791/healthz').get('status')=='ok','CRM is not healthy'
saved=json.loads((Path.home()/'golive-last-call.json').read_text())
last=get('http://192.168.71.9:8790/api/calls/'+saved['call'])['call']
assert last.get('ended_at') and not last['ended_at'].startswith('0001-'),'Previous call has not ended'
expected={'instructions':'639dcecf24dddc73274a7412c017e36258b51679c2fd3ad4e72a595453aa8d25','voice':'65d9d6c5c7c2d5c29e38b777edf8da1dbd764f67deeeaa230724967cafe4e684','greeting':'fa7c33a6b9c732413d932a7453c5c85d4936fcdd8515822bf92e3fc07e2f4df8'}
assert all(sha(saved.get(k,'').encode())==v for k,v in expected.items()),'Saved prompt, voice or greeting changed'
assert sha((root/'configs/telephony.json').read_bytes())=='072ab8dbda962eff682fa56fcd049f70cd3717530e64a06bec97e66618878e7d','Phone profile changed'
assert sha((root/'scripts/phone-brain.sh').read_bytes())=='c21b7fa28d483ec18fb7c2a6eb714c08b6bf40358e48c4235b034d7b441d482a','Dial helper changed'
listeners=subprocess.check_output(['ss','-lntpH','sport = :8765'],text=True)
pids=set(re.findall(r'pid=(\d+)',listeners))
assert len(pids)==1,'Cannot identify phone process'
proc=Path('/proc')/pids.pop()
assert sha((proc/'exe').read_bytes())=='30978356547cce422e0af04363828af9ee7cf2397406d5efc278811c86b32c22','Running binary differs'
env=dict(v.split(b'=',1) for v in (proc/'environ').read_bytes().split(b'\0') if b'=' in v)
assert env.get(b'GOLIVE_REALTIME_STORE_CALLS')==b'1' and env.get(b'GOLIVE_STORE_DIR') and env.get(b'GOLIVE_STORE_TTL_HOURS')==b'8760','Live recording is not enabled as expected'
overview=get('http://192.168.71.9:8790/api/overview')
assert overview.get('recording') is True and overview.get('retention_hours')==8760,'Journal recording state differs'
cfg=json.loads((root/'configs/telephony.json').read_text())
assert not cfg['duplex'].get('talker_opener_url'), 'Talker unexpectedly enabled'
print(json.dumps({'health':h,'previous_call':saved['call'],'previous_call_ended':True,'original_profile_verified':True,'original_context_verified':True,'recording_verified':True,'talker_enabled':False,'aria_revision':binding['revision']}))
PY
