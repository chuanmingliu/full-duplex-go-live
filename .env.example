# Copy to .env.local and fill in. .env.local is gitignored; never commit it.
# Real environment variables always win over this file.

# --- Backend LLM (OpenAI-compatible /v1/chat/completions) ---
DEEPSEEK_API_KEY=
GOLIVE_BACKEND_BASE_URL=https://api.deepseek.com
GOLIVE_BACKEND_MODEL=deepseek-chat

# --- Tencent Cloud realtime ASR ---
TENCENT_ASR_APP_ID=
TENCENT_ASR_SECRET_ID=
TENCENT_ASR_SECRET_KEY=
TENCENT_ASR_ENGINE=16k_zh
TENCENT_ASR_OPEN_TIMEOUT_S=1.5

# --- MiniMax T2A (WebSocket streaming) ---
MINIMAX_TTS_API_KEY=
MINIMAX_TTS_VOICE_ID=
MINIMAX_TTS_MODEL=speech-2.8-turbo
MINIMAX_TTS_SPEED=1.2
MINIMAX_TTS_LANGUAGE_BOOST=auto
# api.minimaxi.com for mainland-platform keys, api.minimax.io for global ones.
MINIMAX_TTS_WEBSOCKET_ENDPOINT=wss://api.minimaxi.com/ws/v1/t2a_v2
MINIMAX_TTS_WEBSOCKET_OPEN_TIMEOUT_S=5
MINIMAX_TTS_WEBSOCKET_RECEIVE_TIMEOUT_S=30
MINIMAX_TTS_WEBSOCKET_MAX_IDLE_S=90

# --- Service overrides (the JSON profile is the better place for these) ---
# GOLIVE_ADDR=:8080
# GOLIVE_ASR=tencent
# GOLIVE_LLM=deepseek
# GOLIVE_TTS=minimax
# GOLIVE_LOG_LEVEL=debug

# --- Mock providers ---
# The phrase the mock recognizer "hears", for demos without credentials.
# GOLIVE_MOCK_TRANSCRIPT=你好，帮我查一下明天的天气
