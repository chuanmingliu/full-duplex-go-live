# Copy to .env.local and fill in. .env.local is gitignored; never commit it.
# Real environment variables always win over this file.

# --- Auth (required by configs/production.json) ---
# Any WebSocket upgrade and /metrics /v1/live/config need this token.
# Browsers pass it as ?token=; golivectl / golivebench use -token or this env.
# GOLIVE_AUTH_TOKEN=
# GOLIVE_AUTH_REQUIRED=true
# Comma-separated Origin allow-list. Empty + auth on = same-host only.
# GOLIVE_ALLOWED_ORIGINS=https://app.example.com
# GOLIVE_TRUST_PROXY=true
# GOLIVE_MAX_SESSIONS=32
# GOLIVE_MAX_SESSIONS_PER_IP=4
# GOLIVE_ALLOW_PROVIDER_OVERRIDE=false
# GOLIVE_LOG_FORMAT=json
# GOLIVE_TLS_CERT_FILE=
# GOLIVE_TLS_KEY_FILE=
# Dedicated Prometheus scrape token (optional). Or set GOLIVE_METRICS_PUBLIC=true
# only when /metrics is not reachable from the internet.
# GOLIVE_METRICS_TOKEN=
# GOLIVE_METRICS_PUBLIC=false
# GOLIVE_AUTH_FAIL_BURST=30

# --- Backend LLM (OpenAI-compatible /v1/chat/completions) ---
DEEPSEEK_API_KEY=
GOLIVE_BACKEND_BASE_URL=https://api.deepseek.com
GOLIVE_BACKEND_MODEL=deepseek-chat

# --- Cerebras (OpenAI-compatible; GOLIVE_LLM=cerebras) ---
# The backend is the dominant latency term in this cascade — 2.4-3.4 s of a
# ~3.8 s answer under a long persona prompt — so a faster one is the largest
# single lever available.
# CEREBRAS_API_KEY=
# qwen-3.8-27b and gpt-oss-120b are the two models Cerebras document on the
# shared endpoint. Gemma 4 31B is served too, but the only exact id their docs
# give is google/gemma-4-31b-it on a *dedicated* endpoint, which uses
# HuggingFace-style ids and its own URL — set both together if you have one.
# GOLIVE_CEREBRAS_MODEL=qwen-3.8-27b
# GOLIVE_CEREBRAS_BASE_URL=https://api.cerebras.ai

# --- Inception Mercury (diffusion LLM, OpenAI-compatible; GOLIVE_LLM=inception) ---
# mercury-2.5 is the current chat model; mercury-edit-2 is the code one.
# The `diffusing: true` flag is deliberately not wired up — see the comment in
# internal/provider/deepseek/llm.go. It makes each chunk carry the whole answer
# rather than the next piece of it, and everything downstream here appends.
# INCEPTION_API_KEY=
# GOLIVE_INCEPTION_MODEL=mercury-2.5
# GOLIVE_INCEPTION_BASE_URL=https://api.inceptionlabs.ai

# --- Tencent Cloud realtime ASR ---
TENCENT_ASR_APP_ID=
TENCENT_ASR_SECRET_ID=
TENCENT_ASR_SECRET_KEY=
TENCENT_ASR_ENGINE=16k_zh
TENCENT_ASR_OPEN_TIMEOUT_S=1.5

# --- MiniMax T2A (WebSocket streaming) ---
MINIMAX_TTS_API_KEY=
MINIMAX_TTS_VOICE_ID=
MINIMAX_TTS_MODEL=speech-2.8-turbo
MINIMAX_TTS_SPEED=1.2
MINIMAX_TTS_LANGUAGE_BOOST=auto
# Two things to get right here, and they are independent.
#
# Host: api.minimaxi.com for mainland-platform keys, api.minimax.io for global
# ones. The wrong one authenticates and then fails at task_start.
#
# Path: /ws/v1/t2a_v2 is the standard endpoint; /ws/v1/t2a_v2_bidi is the
# bidirectional one. They share auth, task_start and audio frames, but only the
# bidirectional one accepts task_flush and task_cancel and documents
# task_continue at arbitrary granularity — so the two latency settings below do
# nothing on the standard one (golive detects the mismatch and says so once,
# rather than sending events the server will reject).
#
# Use ttsprobe to find out what the difference is worth on your account before
# switching:  go run ./cmd/ttsprobe -compare-endpoints -runs 12
MINIMAX_TTS_WEBSOCKET_ENDPOINT=wss://api.minimaxi.com/ws/v1/t2a_v2
# The bidirectional endpoint. Worth trying, but this is the one to suspect
# first if an answer's opening fragment plays and the rest never does: the two
# endpoints end a segment differently, and a segment with nothing to end it
# sits until MINIMAX_TTS_WEBSOCKET_RECEIVE_TIMEOUT_S. See TESTING.md.
# MINIMAX_TTS_WEBSOCKET_ENDPOINT=wss://api.minimaxi.com/ws/v1/t2a_v2_bidi
MINIMAX_TTS_WEBSOCKET_OPEN_TIMEOUT_S=5
MINIMAX_TTS_WEBSOCKET_RECEIVE_TIMEOUT_S=30
MINIMAX_TTS_WEBSOCKET_MAX_IDLE_S=90
# MiniMax sends no pings and closes an idle socket around 120 s (error 2201).
# This keeps it alive through a pause, so the next thing said pays no reconnect.
MINIMAX_TTS_KEEPALIVE_S=30

# --- MiniMax: latency (both require the _bidi endpoint above) ---
# task_cancel on a barge-in, instead of draining the audio already queued for
# text the caller interrupted. One round trip rather than however much was
# buffered, and it falls back to draining if the cancel is not acknowledged.
MINIMAX_TTS_CANCEL_ON_ABANDON=true
# task_flush after a segment with no sentence-ending punctuation. The server
# otherwise buffers such a segment waiting for more text — including the tiny
# first chunk golive cuts specifically to be fast, and the holding fillers.
MINIMAX_TTS_FLUSH_PARTIAL_SEGMENTS=true

# --- MiniMax: how human it sounds ---
# Leave MINIMAX_TTS_EMOTION unset to let MiniMax pick per sentence, which reads
# as more natural over a whole call than pinning one mood. Set it (happy, sad,
# angry, fearful, disgusted, surprised, calm, fluent, whisper) only for an agent
# with a fixed register.
# MINIMAX_TTS_EMOTION=calm
# MINIMAX_TTS_VOL=1.0
# MINIMAX_TTS_PITCH=0
# Continuous inference across segments: better prosody over golive's deliberately
# short first chunk, at the cost of latency. speech-2.8 only.
# MINIMAX_TTS_CONTINUOUS_SOUND=false
# The highest-value setting on this list for most deployments: an agent says the
# same proper nouns hundreds of times a day, and mispronouncing them is the most
# noticeable unnaturalness there is. Comma-separated "written/spoken" pairs.
# MINIMAX_TTS_PRONUNCIATION=golive/勾莱夫,API/A P I
# JSON, passed through: pitch/intensity/timbre in [-100,100], plus an optional
# sound_effects preset (spacious_echo, auditorium_echo, lofi_telephone, robotic).
# MINIMAX_TTS_VOICE_MODIFY={"intensity":15}
# JSON, up to four voices blended by weight (1-100).
# MINIMAX_TTS_TIMBER_WEIGHTS=[{"voice_id":"a","weight":70},{"voice_id":"b","weight":30}]
# MINIMAX_TTS_ENGLISH_NORMALIZATION=false

# --- Service overrides (the JSON profile is the better place for these) ---
# GOLIVE_ADDR=:8080
# GOLIVE_ASR=tencent
# GOLIVE_LLM=deepseek
# GOLIVE_TTS=minimax
# GOLIVE_LOG_LEVEL=debug

# --- Mock providers ---
# The phrase the mock recognizer "hears", for demos without credentials.
# GOLIVE_MOCK_TRANSCRIPT=你好，帮我查一下明天的天气
