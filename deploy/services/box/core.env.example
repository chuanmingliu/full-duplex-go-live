# Non-secret locations only. Copy outside Git, review every path, then use --env-file.
# Set the local image ID produced/verified from the reviewed SOURCE_COMMIT.
GOLIVE_IMAGE=sha256:REPLACE_WITH_VERIFIED_IMAGE_ID
SERVICE_UID=1000
SERVICE_GID=1000
BOX_LAN_IP=192.168.71.9
TALKER_URL=http://192.168.71.101:18081
CONFIG_DIR=/home/chuanming/golive-telephony/configs
PROVIDERS_ENV=/home/chuanming/golive-telephony.env
ORIGINATOR_ENV=/home/chuanming/aria/.env
CALLS_DIR=/home/chuanming/golive-calls
CRM_DIR=/home/chuanming/golive-crm
JOURNAL_DIR=/home/chuanming/golive-journal
ARCHIVE_DIR=/home/chuanming/golive-archive
DESK_DIR=/home/chuanming/golive-desk
QUOTE_DIR=/home/chuanming/golive-quotesvc
EDGE_DIR=/home/chuanming/golive-edge
SIM_DIR=/home/chuanming/golive-sim
NOTES_DIR=/home/chuanming/golive-telephony/journal
# These two paths require a deliberate migration; see README before activation.
LAST_CALL_DIR=/home/chuanming/golive-state/last-call
LOG_DIR=/home/chuanming/golive-state/logs
CALLS_TTL_HOURS=720
DEEPSEEK_LANES=8
PHONE_LOG_LEVEL=debug
QUOTE_COMPUTE_MS=2500
QUOTE_JITTER_MS=2000
# Match native GOLIVE_FOCUS_TOKEN_FILE when the edge token exists.
# Container path, not the host path. Blank retains the profile's token-file setting.
FOCUS_TOKEN_FILE=/edge/api.token
# Blank keeps CRM's persisted quote-api base_url. Preserve any native override here.
CRM_QUOTE_API_BASE=
